# offline runs without a model or an API key. Restart the server after changes.
RP_MODE=offline
# local = single-user localhost; accounts = login and per-user projects.
# Create the first administrator using the accounts CLI before enabling this.
RP_AUTH_MODE=local
# Use true only behind a configured HTTPS endpoint. Local HTTP uses false.
RP_COOKIE_SECURE=false
# Leave blank for localhost. HTTPS deployment also requires accounts + secure cookies.
RP_PUBLIC_ORIGIN=
RP_DATA_DIR=./data
# Per-file upload limit in MB (1 MB = 1024 * 1024 bytes), allowed range 1–512.
# Restart the service after changing this value; the UI reads it from the server.
RP_MAX_UPLOAD_MB=200
# Per-account limits (local mode shares one quota). Original files only, not backups.
RP_MAX_PROJECTS=20
RP_MAX_SOURCES=200
RP_MAX_STORAGE_MB=2048
RP_MAX_ACTIVE_TASKS=3
RP_MAX_ACTIVE_IMPORTS=2
RP_MAX_TASKS_DAILY=100
RP_MIN_FREE_DISK_MB=512
# To enable real LLM tool calling, use RP_MODE=llm and a model that supports
# Chat Completions function calling. Model names depend on your provider.
RP_API_BASE=https://api.openai.com/v1
RP_API_KEY=
RP_MODEL=
# Optional: enable semantic retrieval alongside BM25. Blank = BM25 only.
RP_EMBED_MODEL=
# Optional GitHub token, stored server-side only. Public repositories need none.
RP_GITHUB_TOKEN=
RP_MAX_TOOL_CALLS=8
