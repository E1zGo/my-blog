# Proposed subdomain. Configure DNS only after a persistent server is ready.
RP_PUBLIC_ORIGIN=https://research.e1zgo.top
RP_AUTH_MODE=accounts
RP_COOKIE_SECURE=true
RP_DATA_DIR=/var/lib/researchpilot/data
RP_MODE=offline
RP_MAX_UPLOAD_MB=200
RP_MAX_PROJECTS=20
RP_MAX_SOURCES=200
RP_MAX_STORAGE_MB=2048
RP_MAX_ACTIVE_TASKS=3
RP_MAX_ACTIVE_IMPORTS=2
RP_MAX_TASKS_DAILY=100
RP_MIN_FREE_DISK_MB=512
# Optional future model settings. Never put real keys into Git.
RP_API_KEY=
RP_MODEL=
RP_EMBED_MODEL=
RP_GITHUB_TOKEN=
